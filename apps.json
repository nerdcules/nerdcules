{
  "o-rdp": {
    "repo": "https://github.com/nerdcules/o-rdp.git",
    "kind": "makepkg",
    "package": "o-rdp",
    "pkgbuild": "pkgbuild"
  },
  "snoopy": {
    "repo": "https://github.com/nerdcules/snoopy.git",
    "kind": "makepkg",
    "package": "snoopy-phone",
    "pkgbuild": "pkgbuild",
    "formerly": [
      "snoopy"
    ]
  },
  "fathom": {
    "repo": "https://github.com/nerdcules/fathom.git",
    "kind": "fathom-update",
    "command": "fathom-update"
  },
  "sankofa": {
    "repo": "https://github.com/nerdcules/sankofa.git",
    "kind": "release-tarball",
    "asset": "{repo}/releases/download/{tag}/sankofa-linux-{arch}.tar.gz",
    "home": "~/.local/share/sankofa",
    "command": "sankofa"
  },
  "ward": {
    "repo": "https://github.com/nerdcules/ward.git",
    "kind": "makepkg",
    "package": "ward",
    "pkgbuild": "pkgbuild"
  },
  "codegraph": {
    "repo": "https://github.com/nerdcules/CodeGraph.git",
    "kind": "install-script",
    "script": "{repo}/raw/{tag}/codegraph/install.sh",
    "args": [
      "--version",
      "{tag}",
      "--yes",
      "--no-vscode"
    ],
    "version_file": "~/.codegraph/bin/VERSION"
  },
  "imbizo": {
    "repo": "https://github.com/nerdcules/imbizo.git",
    "kind": "makepkg",
    "package": "imbizo",
    "pkgbuild": "pkgbuild"
  }
}
